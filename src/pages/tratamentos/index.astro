---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Steps from '../../components/Steps.astro';
import Cta from '../../components/Cta.astro';
import { treatments } from '../../data/treatments';

const siteUrl = (Astro.site?.href ?? '').replace(/\/$/, '');
const title = 'Tratamentos faciais e corporais em Itajaí | Rose Paulichen Estética';
const description =
  'Criolipólise, Hipro, drenagem linfática Renata França, Multishape, depilação a laser, limpeza de pele, microagulhamento e tratamento de acne na Praia Brava, Itajaí.';
const groups = [
  { label: 'Corpo', items: treatments.filter((t) => t.area !== 'Facial') },
  { label: 'Rosto', items: treatments.filter((t) => t.area !== 'Corporal') },
];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Tratamentos da Rose Paulichen Estética Avançada',
    itemListElement: treatments.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.name, url: `${siteUrl}/tratamentos/${t.slug}/` })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'Tratamentos', item: `${siteUrl}/tratamentos/` },
    ],
  },
];
---
<Base title={title} description={description} schema={schema}>
  <section class="hero" aria-labelledby="tt-h1" style="padding-bottom:clamp(32px,5vw,64px)">
    <div class="wrap" style="display:grid;gap:24px;max-width:1280px">
      <span class="eyebrow" data-load style="--d:0.1s">Tratamentos · Praia Brava, Itajaí</span>
      <h1 class="display" id="tt-h1" style="font-size:var(--step-5)">
        <span class="line"><span style="--d:0.15s">Tratamentos faciais</span></span>
        <span class="line"><span style="--d:0.28s">e corporais <em>em Itajaí</em></span></span>
      </h1>
      <p class="lead" data-load style="--d:0.5s">Escolha por onde quer começar. Se ainda não sabe, tudo bem: a avaliação existe justamente pra isso.</p>
    </div>
  </section>
  {groups.map((g) => (
    <section class="section" style="padding-top:0" aria-label={g.label}>
      <div class="wrap" style="display:grid;gap:24px">
        <h2 class="eyebrow" data-reveal>{g.label}</h2>
        <div class="t-list">
          {g.items.map((t, i) => (
            <a class="t-row" href={`/tratamentos/${t.slug}/`} data-hue={t.hue} data-name={t.name} data-reveal style={`--d:${(i % 4) * 0.05}s`}>
              <span class="t-row__name">{t.name}</span>
              <span class="t-row__area">{t.area}</span>
              <span class="t-row__desc">{t.card}</span>
              <span class="t-row__go" aria-hidden="true"><Icon name="arrow-up-right" /></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}
  <div class="t-preview" data-tpreview aria-hidden="true"><div class="arch__art"></div><div class="arch__grain"></div><span class="t-preview__label"></span></div>
  <Steps />
  <Cta />
</Base>
