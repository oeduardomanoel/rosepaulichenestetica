---
import Base from '../../layouts/Base.astro';
import ArchArt from '../../components/ArchArt.astro';
import WaButton from '../../components/WaButton.astro';
import Stars from '../../components/Stars.astro';
import Icon from '../../components/Icon.astro';
import Steps from '../../components/Steps.astro';
import Reviews from '../../components/Reviews.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import { site } from '../../data/site';
import { treatments, type Treatment } from '../../data/treatments';
import { reviewsFor } from '../../data/reviews';
import { photos } from '../../data/photos';

export function getStaticPaths() {
  return treatments.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}

const { t } = Astro.props as { t: Treatment };
const siteUrl = (Astro.site?.href ?? '').replace(/\/$/, '');
const pageUrl = `${siteUrl}/tratamentos/${t.slug}/`;
const others = treatments.filter((o) => o.slug !== t.slug);
const related = reviewsFor(t.slug, 3);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${pageUrl}#servico`,
    name: `${t.name} em Itajaí`,
    serviceType: t.name,
    description: t.metaDescription,
    url: pageUrl,
    provider: { '@id': `${siteUrl}/#negocio` },
    areaServed: [{ '@type': 'City', name: 'Itajaí' }, { '@type': 'City', name: 'Balneário Camboriú' }],
    audience: { '@type': 'PeopleAudience', geographicArea: { '@type': 'Place', name: 'Itajaí, SC' } },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: t.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'Tratamentos', item: `${siteUrl}/tratamentos/` },
      { '@type': 'ListItem', position: 3, name: t.name, item: pageUrl },
    ],
  },
];
---

<Base title={t.seoTitle} description={t.metaDescription} schema={schema} waMessage={t.wa}>
  <section class="hero s-hero" aria-labelledby="t-h1">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <nav aria-label="Você está em" data-load style="--d:0.05s">
          <ol class="crumbs">
            <li><a href="/">Início</a></li>
            <li><a href="/tratamentos/">Tratamentos</a></li>
            <li aria-current="page">{t.name}</li>
          </ol>
        </nav>
        <span class="eyebrow" data-load style="--d:0.1s">{t.area} · Praia Brava, Itajaí</span>
        <h1 class="display" id="t-h1">
          <span class="line"><span style="--d:0.15s">{t.h1}</span></span>
          <span class="line accent"><span style="--d:0.3s">{t.h1Accent}</span></span>
        </h1>
        <p class="lead" data-load style="--d:0.55s">{t.lead}</p>
        <ul class="traits" data-load style="--d:0.65s">{t.traits.map((x) => <li>{x}</li>)}</ul>
        <div class="hero__ctas" data-load style="--d:0.75s">
          <WaButton origin={`hero-${t.slug}`} message={t.wa} label="Agendar avaliação" />
          <a class="btn btn--ghost" href="#perguntas"><span>Tirar dúvidas</span><Icon name="arrow" /></a>
        </div>
        <div class="proof" data-load style="--d:0.85s">
          <span class="proof__stars"><Stars /> {site.rating.value} no Google</span>
          <span class="proof__sep" aria-hidden="true"></span>
          <span>{site.rating.count} avaliações</span>
        </div>
      </div>
      <div class="hero__visual" data-load style="--d:0.3s">
        <div data-parallax="0.06">
          <ArchArt hue={t.hue} mono={t.name.charAt(0)} img={photos.treatments[t.slug]} alt={`${t.name} na Rose Paulichen Estética Avançada, Itajaí`} eager />
        </div>
        <div class="tag-card"><strong>{t.name}</strong>{t.area}</div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="oque-t" style="padding-top:clamp(24px,4vw,48px)">
    <div class="wrap split">
      <div>
        <span class="eyebrow" data-reveal>Entenda</span>
        <h2 class="display h2" id="oque-t" data-reveal>O que é {t.withArticle}</h2>
      </div>
      <div style="display:grid;gap:48px;min-width:0">
        <div class="prose" style="font-size:var(--step-1);line-height:1.6" data-reveal>
          {t.whatIs.map((p) => <p>{p}</p>)}
        </div>
        <div style="display:grid;gap:18px">
          <h3 class="h3" data-reveal>Para quem é indicado</h3>
          <ul class="checks" data-reveal>{t.forWho.map((x) => <li>{x}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section aria-label={`${t.name} com a Rose`} style="padding-bottom:clamp(24px,4vw,48px)">
    <div class="wrap">
      <div class="callout" data-reveal="scale">
        <span class="eyebrow">Com a Rose</span>
        <p>{t.withRose}</p>
        <div><WaButton origin={`callout-${t.slug}`} message={t.wa} variant="btn--light" label="Falar com a Rose" /></div>
      </div>
    </div>
  </section>

  <Steps title={`Como funciona ${t.withArticle} aqui`} intro="Toda indicação parte de uma avaliação individual. O número de sessões e o intervalo entre elas saem dela." />

  <Reviews items={related} title="O que as clientes contam" compact />

  <Faq items={t.faq} title={`Dúvidas sobre ${t.term}`} waMessage={t.wa} />

  <section class="section" aria-labelledby="outros-t" style="padding-top:0">
    <div class="wrap" style="display:grid;gap:28px">
      <h2 class="display h3" id="outros-t" data-reveal>Outros tratamentos</h2>
      <div class="others" data-reveal>
        {others.map((o) => (
          <a class="other" href={`/tratamentos/${o.slug}/`}><span>{o.name}</span><Icon name="arrow-up-right" /></a>
        ))}
      </div>
    </div>
  </section>

  <Cta title={`Seu protocolo de ${t.term}`} accent="começa pela avaliação." waMessage={t.wa} origin={`cta-${t.slug}`} />
</Base>
